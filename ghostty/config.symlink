theme = iterm2 Solarized Dark
window-padding-x = 4

font-family = "Jetbrains Mono"
# Patch font for drawing the arrow characters of the pure prompt.
# The characters aren't available on Jetbrains Mono, take them from Menlo.
font-codepoint-map = U+21E1,U+21E3=Menlo
font-size = 14
font-thicken = true
# Disable ligatures
font-feature = -calt

# Give letters a bit more room
adjust-cell-height = 10%

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

# No warning dialogue before closing
confirm-close-surface = false

# set terminal info for tmux and other programs
term = "xterm-ghostty"
