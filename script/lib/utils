#!/usr/bin/env bash

function info() {
  local message=$1
  echo -e "[\033[0;34mINFO\033[0m] $message" >&2
}

function warn() {
  local message=$1
  echo -e "[\033[0;33mWARN\033[0m] $message" >&2
}

function success() {
  local message=$1
  echo -e "[ \033[0;32mOK\033[0m ] $message" >&2
}

function error() {
  local message=$1
  echo -e "[\033[0;31mFAIL\033[0m] $message" >&2
}

function require_tool() {
  local tool=$1
  if ! command -v "$tool" >/dev/null; then
    error "Please install $tool"
    exit 1
  fi
}

function ask() {
  local message=$1
  echo -e "[ \033[0;33m??\033[0m ] $message" >&2
  echo -en "[ \033[0;33m!!\033[0m ] " >&2
}

function path_exists() {
  local dest=$1
  # -e: anything exists, -L: catch (broken) symlinks
  [ -e "$dest" ]  || [ -L "$dest" ]
}

function symlink () {
  local src=$1 dest=$2
  local action

  info "Link '$src' to '$dest'…"
  if path_exists "$dest"; then
    if [ "$(readlink "$dest")" == "$src" ]; then
      success "Link '$dest' already exists…"
      return 0
    else
      ask "File already exists: $dest ($(basename "$src")) [s]kip/[o]overwrite"
      read -r -e -n 1 action </dev/tty
      case "$action" in
        o )
          local backup
          backup="$dest.backup.$(date +%Y-%m-%d-%H:%M:%S)"
          warn "Move '$dest' to '$dest.backup'…"
          mv "$dest" "$backup"
          ln -s "$src" "$dest"
          success "Linked $src to $dest"
          ;;
        s )
          success "Skip symlink $src"
          ;;
        * )
          warn "Unknown option '$action', skip $src"
          ;;
      esac
    fi
  else
    ln -s "$src" "$dest"
    success "Linked $src to $dest"
  fi
}

function create_symlinks() {
  local topic_dir=$1
  local base_destination=${2:-"$HOME/."}
  local files

  files=$(find "$topic_dir" -maxdepth 1 -name "*.symlink")

  for src in $files; do
    name=$(basename "$src" .symlink)
    dest="$base_destination$name"
    symlink "$src" "$dest"
  done
}
