#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# To debug, uncomment:
# set -o xtrace

SCRIPT_DIR=$(dirname "$0")
# shellcheck source=./lib/utils
source "$SCRIPT_DIR/lib/utils"

cd "$SCRIPT_DIR/.."

require_tool stylua
require_tool npx

info "Format Lua…"
stylua neovim/

info "Format Markdown…"
npx prettier --write ./*.md
